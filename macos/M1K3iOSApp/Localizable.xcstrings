    "A quick note, like \"should have searched the web\", so this can be fixed later." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze Notiz, etwa „hätte im Web suchen sollen“, damit das später behoben werden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una nota rápida, como “debería haber buscado en la web”, para poder corregirlo más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une petite note, comme « aurait dû chercher sur le web », pour qu’on puisse le corriger plus tard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um comentário rápido, como “deveria ter buscado na web”, para que isso possa ser corrigido depois."
          }
        }
      }
    },
