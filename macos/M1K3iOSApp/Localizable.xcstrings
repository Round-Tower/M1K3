    "New weights for %@, %@. %@ keeps working meanwhile; keep M1K3 open until it's done." : {
      "comment" : "%1$@ is a brain's name (Lil, Big): keep it untranslated; %2$@ is a download size",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Gewichte für %1$@, %2$@. %3$@ läuft währenddessen weiter; lass M1K3 geöffnet, bis alles fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "New weights for %1$@, %2$@. %3$@ keeps working meanwhile; keep M1K3 open until it's done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pesos nuevos para %1$@, %2$@. %3$@ sigue funcionando mientras tanto; mantén M1K3 abierto hasta que termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouveaux poids pour %1$@, %2$@. %3$@ continue de fonctionner en attendant ; garde M1K3 ouvert jusqu’à la fin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Novos pesos para %1$@, %2$@. O %3$@ continua funcionando enquanto isso; mantenha o M1K3 aberto até terminar."
          }
        }
      }
    },
