    "As M1K3 remembers things, they appear here as a constellation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was sich M1K3 merkt, erscheint hier als Konstellation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A medida que M1K3 recuerda cosas, aparecen aquí como una constelación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À mesure que M1K3 retient des choses, elles apparaissent ici sous forme de constellation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conforme o M1K3 lembra das coisas, elas aparecem aqui como uma constelação."
