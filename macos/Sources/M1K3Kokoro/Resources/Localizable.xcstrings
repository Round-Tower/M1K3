          "stringUnit" : {
            "state" : "translated",
            "value" : "O download do Kokoro falhou com o status HTTP %lld"
          }
        }
      }
    },
    "Kokoro's %@ does not match the digest pinned for round-tower/Kokoro-82M-bf16 — refusing to use it" : {
