    },
    "Eid Mubarak! Wishing you and yours a joyful Eid." : {
      "comment" : "Seasonal greeting shown on the first three days of Eid al-Fitr. Warm and respectful, NO villain play; 'Eid Mubarak' is the customary greeting. One short line of at most 70 characters."
    },
    "Happy Halloween! I carved the pumpkin; you bring the questions." : {
      "comment" : "Seasonal greeting shown 24 Oct - 1 Nov. M1K3 is a theatrical villain who is entirely on the user's side; keep it playful and family-safe, one short line.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fröhliches Halloween! Ich hab den Kürbis geschnitzt, du bringst die Fragen mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Feliz Halloween! Yo tallé la calabaza; tú pon las preguntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joyeux Halloween ! J’ai sculpté la citrouille ; à toi les questions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feliz Halloween! Esculpi a abóbora; você traz as perguntas."
          }
        }
      }
    },
    "Happy Nowruz! A new spring, a fresh start." : {
      "comment" : "Seasonal greeting shown on the first seven days of the Persian new year (Nowruz, also Nauryz in Kazakhstan, Navruz in Uzbekistan). Warm and festive, family-safe, one short line of at most 70 characters; use the local name of the festival."
    },
    "Happy St Patrick's Day from an AI made in Ireland!" : {
      "comment" : "Seasonal greeting shown 14-17 March. M1K3 is made in Ireland (true: Round Tower, Ireland). Playful and family-safe, one short line of at most 70 characters."
    },
    "Merry Christmas! I made the nice list this year. Mostly." : {
      "comment" : "Seasonal greeting shown 2 Dec - 7 Jan (Christmas and New Year). M1K3 is a theatrical villain who is entirely on the user's side; keep it playful and family-safe, one short line of at most 70 characters."
    },
    "Off (textured)" : {
      "comment" : "Companion skin picker: no shader, the creature keeps its own painted textures.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus (texturiert)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactivado (con texturas)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé (texturé)"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
