    },
    "Eid Mubarak! Wishing you and yours a joyful Eid." : {
      "comment" : "Greeting shown on the first three days of Eid al-Fitr. Warm, respectful, NO villain play; 'Eid Mubarak' is customary. One line, at most 70 characters."
    },
    "Happy Halloween! I carved the pumpkin; you bring the questions." : {
      "comment" : "Seasonal greeting shown 24 Oct - 1 Nov. M1K3 is a theatrical villain who is entirely on the user's side; keep it playful and family-safe, one short line.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fröhliches Halloween! Ich hab den Kürbis geschnitzt, du bringst die Fragen mit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Feliz Halloween! Yo tallé la calabaza; tú pon las preguntas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joyeux Halloween ! J’ai sculpté la citrouille ; à toi les questions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feliz Halloween! Esculpi a abóbora; você traz as perguntas."
          }
        }
      }
    },
    "Happy Nowruz! A new spring, a fresh start." : {
      "comment" : "Greeting for the first 7 days of Nowruz (Nauryz in Kazakhstan, Navruz in Uzbekistan); use the local name. Warm, family-safe, at most 70 characters."
    },
    "Happy St Patrick's Day from an AI made in Ireland!" : {
      "comment" : "Seasonal greeting shown 14-17 March. M1K3 is made in Ireland (true: Round Tower, Ireland). Playful and family-safe, one short line of at most 70 characters."
    },
    "Merry Christmas! I made the nice list this year. Mostly." : {
      "comment" : "Greeting shown 2 Dec - 7 Jan (Christmas, New Year). M1K3 is a playful villain on the user's side; family-safe, one line, at most 70 characters."
    },
    "Off (textured)" : {
      "comment" : "Companion skin picker: no shader, the creature keeps its own painted textures.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
