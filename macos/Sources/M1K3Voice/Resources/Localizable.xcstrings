    "End with “%@” and M1K3 will take its turn" : {
      "comment" : "Voice mode hint while listening. %@ is the spoken submit word, already translated (the key “please” in this catalog). Use this language's quotation marks.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag am Ende „%@“, dann ist M1K3 dran"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina con “%@” y M1K3 tomará la palabra"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine ta phrase par « %@ » et M1K3 prendra la parole"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine com “%@” e será a vez do M1K3"
          }
        }
      }
    },
