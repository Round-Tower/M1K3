    "Finds your notes by meaning, not just matching words. Turning it on re-indexes your notes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Findet deine Notizen nach Bedeutung, nicht nur nach passenden Wörtern. Beim Einschalten werden deine Notizen neu indexiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encuentra tus notas por su significado, no solo por palabras que coinciden. Al activarla, se reindexan tus notas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet de retrouver tes notes par leur sens, pas seulement par les mots exacts. L’activer réindexe tes notes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontra suas notas pelo significado, não só por palavras iguais. Ao ligar, suas notas são reindexadas."
          }
        }
      }
    },
