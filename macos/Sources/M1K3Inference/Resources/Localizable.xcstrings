  "strings" : {
    "%@ are each a switch in Settings." : {

    },
    "%@ is a switch in Settings." : {

    },
    "%@ needs a newer chip than this device has. Staying on Mini." : {
      "comment" : "Settings note on an older chip. The argument is a brain name (Lil, Big). Mini is a brain name: never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht einen neueren Chip, als dieses Gerät hat. Es bleibt bei Mini."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita un chip más reciente que el de este dispositivo. Seguimos con Mini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ demande une puce plus récente que celle de cet appareil. On reste sur Mini."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ precisa de um chip mais novo do que o deste dispositivo. Continuando no Mini."
          }
        }
      }
    },
    "%@ runs on a real device — the Simulator has no GPU for MLX. Staying on Mini." : {
      "comment" : "Settings note in the Simulator. The argument is a brain name (Lil, Big). Mini is a brain name: never translated.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht ein echtes Gerät – der Simulator hat keine GPU für MLX. Es bleibt bei Mini."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ funciona en un dispositivo real — el Simulador no tiene GPU para MLX. Seguimos con Mini."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fonctionne sur un vrai appareil — le Simulator n’a pas de GPU pour MLX. On reste sur Mini."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O %@ roda em um dispositivo real — o Simulator não tem GPU para MLX. Continuando no Mini."
          }
        }
      }
    },
    "%lld files are waiting. They go in the box when this reply ends." : {
      "comment" : "Hint over the chat's message box: files shared to M1K3 from another app wait until M1K3 finishes its answer. 'the box' is the message box where you type. Plural by count.",
