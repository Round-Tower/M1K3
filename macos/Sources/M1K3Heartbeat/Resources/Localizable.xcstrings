  "strings" : {
    "A quiet stretch — the next pulse comes when something happens, or with the morning." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade ist es ruhig – der nächste Puls kommt, wenn etwas passiert, oder am Morgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un rato tranquilo: el próximo pulso llegará cuando pase algo, o por la mañana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un moment calme — le prochain bilan arrivera quand il se passera quelque chose, ou au matin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um período tranquilo — o próximo pulso vem quando algo acontecer, ou de manhã."
          }
        }
      }
    },
