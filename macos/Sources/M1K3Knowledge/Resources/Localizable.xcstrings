    "This looks like raw markup (SVG/XML/HTML), not readable text — convert it to prose or PDF first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nach rohem Markup (SVG/XML/HTML) aus, nicht nach lesbarem Text – wandle es zuerst in Fließtext oder PDF um."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto parece marcado sin procesar (SVG/XML/HTML), no texto legible: conviértelo primero a prosa o PDF."
