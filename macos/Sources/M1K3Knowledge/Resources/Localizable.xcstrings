    "It’s empty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dokument ist leer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El documento está vacío."
          }
        },
        "fr" : {
          "stringUnit" : {
