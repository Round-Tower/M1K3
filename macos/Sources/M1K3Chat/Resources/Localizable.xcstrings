  "strings" : {
    "%@ answers. Web search is off." : {
      "comment" : "VoiceOver label of the chat status line. %@ is the brain's name (Mini, Lil, Big, Brain at Home) or Private Cloud Compute; keep it untranslated"
    },
    "%@ answers. Web search is on." : {
