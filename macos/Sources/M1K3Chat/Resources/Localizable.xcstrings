    "I couldn't make out that photo. Try again?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich konnte auf dem Foto nichts erkennen. Noch mal versuchen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No he podido ver bien esa foto. ¿Lo intentas de nuevo?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai pas réussi à déchiffrer cette photo. Tu réessaies ?"
