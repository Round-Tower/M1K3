# M1K3 — Fastlane (METADATA-ONLY).
#
# Build / archive / sign / notarize live in bash (tools/release/release-macos.sh
# for the direct DMG, release-mas.sh for the App Store .pkg) — exactly the prior knowledge-server's
# split. This file is ONLY the App Store Connect metadata/screenshots/TestFlight
# API surface, where `deliver` + Spaceship beat bash.
#
# Auth: API key (preferred) or Apple ID session login.
#   API key: set APP_STORE_CONNECT_API_KEY_PATH (fastlane JSON format)
#   or drop it at ~/.appstoreconnect/private_keys/asc_api_key.json.
#   Apple ID: falls back to the Appfile apple_id (interactive 2FA).
#
# Review: Kev + claude-opus-5, 2026-09-13 — the metadata/screenshot paths are
# absolute (they resolved against macos/, not this folder, so the lanes pushed
# nothing and reported success); a `platform :ios` screenshots lane joins.
# Confidence HIGH (verified by checksum against App Store Connect).
# MurphySig: Metadata-only Fastlane mirroring the prior knowledge-server's proven split. Confidence: HIGH.
# Review: Kev + claude-opus-5, 2026-09-12 — API-key auth (fastlane JSON key at
# APP_STORE_CONNECT_API_KEY_PATH or ~/.appstoreconnect/private_keys/) with the
# Apple-ID session as fallback; precheck skips IAPs (it cannot read them under
# an API key); FASTLANE_SKIP_DOCS keeps the hand-written README. Confidence now
# HIGH for the wiring, verify-by-run for the first API-key `mac metadata` push.
# Review: Kev + claude-opus-5.5, 2026-10-01 — `ios metadata` joins (the iPhone
# listing gets its own copy in metadata_ios; it carried the Mac's word for word);
# name + subtitle are record-wide, so both lanes push the same values and
# check_store_metadata.py fails the PR if the folders drift. "What to Test"
# moved to TestFlight/notes/ (Xcode Cloud reads it at archive time).
# Confidence now 0.8 — the ios lane is the mac lane with platform "ios",
# unproven until Kev's first run.
# Review: Kev + claude-opus-5-5, 2026-10-04 — `mac previews` / `ios previews` upload the App Previews
# (previews_mac|ios/en-US/*.mov, gitignored) through Spaceship directly: deliver's app_previews_path
# skips every Mac preview (fastlane 2.240.1's AppPreviewSet resolution table has no DESKTOP entry —
# read from the installed gem). Apple's spec is checked locally first; `dry_run:true` checks the files
# and prints the target version (read-only), uploading nothing. Submitted versions are refused.
# Ported from Cartogram's :previews lane, minus its Mac size table (16:10 — Apple's is 1920×1080).
# Confidence 0.7 — the dry run is verified; the first real upload is Kev's.
# https://murphysig.dev

require "digest"
require "fastlane_core/video_utils" # not auto-loaded; the preview checks read duration + size

default_platform(:mac)

APP_ID      = "app.m1k3"
TEAM_ID     = "76DJH43A4P"
APPLE_LOGIN = ENV["APPLE_ID"] || "kevin@round-tower.ie"
# Absolute, anchored to THIS file: fastlane runs lanes from the project root
# (macos/), so "./screenshots_mac" resolved to an empty macos/screenshots_mac that
# fastlane created on the fly — the screenshots lane "Successfully uploaded all
# screenshots" while uploading none (2026-09-13, caught by checksum against ASC).
META_PATH       = File.expand_path("metadata_mac", __dir__)
IOS_META_PATH   = File.expand_path("metadata_ios", __dir__)
TESTFLIGHT_DIR  = File.expand_path("../TestFlight", __dir__)
SHOTS_PATH      = File.expand_path("screenshots_mac", __dir__)
IOS_SHOTS_PATH  = File.expand_path("screenshots_ios", __dir__)
MAC_PREVIEWS    = File.expand_path("previews_mac", __dir__)
IOS_PREVIEWS    = File.expand_path("previews_ios", __dir__)
# README.md in this folder is hand-written; without this fastlane regenerates
# it after every lane and the tool-split / Xcode Cloud notes are lost.
ENV["FASTLANE_SKIP_DOCS"] = "1"

ASC_KEY     = ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
              File.expand_path("~/.appstoreconnect/private_keys/asc_api_key.json")

def asc_api_key
  return nil unless File.exist?(ASC_KEY)
  key = JSON.parse(File.read(ASC_KEY))
  app_store_connect_api_key(
    key_id:       key["key_id"],
    issuer_id:    key["issuer_id"],
    key_content:  key["key"],
    is_key_content_base64: false,
    in_house:     false
  )
end

# App Previews (developer.apple.com/help/app-store-connect/reference/app-information/
# app-preview-specifications, re-checked 2026-10-02): 15–30 s, ≤ 500 MB, ≤ 3 per set.
# Mac: 1920×1080 only. iPhone 6.9" (IPHONE_67): 886×1920 portrait. Codec, fps and the audio track
# are encode_preview.py's checks (marketing/motion); this re-checks size/length/resolution on disk.
def upload_app_previews(platform:, preview_type:, dir:, sizes:, dry_run: false)
  paths = Dir.glob(File.join(dir, "en-US", "*.{mov,m4v,mp4}")).sort
  UI.user_error!("No previews in #{dir}/en-US") if paths.empty?
  UI.user_error!("Apple allows at most 3 App Previews per set (found #{paths.size})") if paths.size > 3
  paths.each do |path|
    name = File.basename(path)
    mb = File.size(path) / (1024.0 * 1024.0)
    UI.user_error!("#{name} is #{mb.round(1)} MB (limit 500)") if mb > 500
    secs = FastlaneCore::VideoUtils.read_video_duration_seconds(path)
    UI.user_error!("#{name}: couldn't read its duration") unless secs
    UI.user_error!("#{name} is #{secs.round(2)} s (Apple wants 15–30)") unless secs.between?(15.0, 30.0)
    res = FastlaneCore::VideoUtils.read_video_resolution(path)
    UI.user_error!("#{name}: couldn't read its resolution") unless res
    UI.user_error!("#{name} is #{res.join('x')} (wants #{sizes.map { |w| w.join('x') }.join(' or ')})") unless sizes.include?(res)
    UI.success("#{name}: #{res.join('x')}, #{secs.round(1)} s, #{mb.round(1)} MB — within spec")
  end

  # Resolve the target read-only — dry_run included — so the version, platform and state an upload
  # would hit are on screen first. fastlane's "edit" version also matches WAITING_FOR_REVIEW (its
  # filter, read from the 2.240.1 gem); a preview must never land on a submitted version.
  UI.user_error!("No App Store Connect API key at #{ASC_KEY}") unless asc_api_key # also logs Spaceship in
  app = Spaceship::ConnectAPI::App.find(APP_ID)
  UI.user_error!("App not found: #{APP_ID}") unless app
  version = app.get_edit_app_store_version(platform: platform)
  UI.user_error!("No editable #{platform} version") unless version
  editable = %w[PREPARE_FOR_SUBMISSION DEVELOPER_REJECTED REJECTED METADATA_REJECTED]
  state = version.app_version_state || version.app_store_state
  UI.message("Target: #{platform} #{version.version_string} (#{state}) · en-US · #{preview_type}")
  UI.user_error!("#{version.version_string} is #{state} — previews go only on an editable version") unless editable.include?(state)
  loc = version.get_app_store_version_localizations.find { |l| l.locale == "en-US" }
  UI.user_error!("No en-US localization on #{version.version_string}") unless loc

  set = loc.get_app_preview_sets(includes: "appPreviews").find { |s| s.preview_type == preview_type }
  existing = set ? (set.app_previews || []).map(&:source_file_checksum).compact : []
  to_upload = paths.reject { |path| existing.include?(Digest::MD5.file(path).hexdigest) }
  UI.message("On App Store Connect: #{existing.size} · to upload: #{to_upload.size}")
  if existing.size + to_upload.size > 3
    UI.user_error!("#{existing.size} already in the #{preview_type} set + #{to_upload.size} new > 3 — " \
                   "delete the stale preview in App Store Connect first")
  end
  if dry_run
    UI.important("dry_run — nothing uploaded")
    return
  end

  set ||= loc.create_app_preview_set(attributes: { previewType: preview_type })
  to_upload.each do |path|
    UI.message("Uploading #{File.basename(path)} to #{version.version_string} #{preview_type}…")
    set.upload_preview(path: path, wait_for_processing: false)
    UI.success("Uploaded #{File.basename(path)} — App Store Connect processes it for a few minutes")
  end
end

# Update TestFlight "What to Test" on the latest build (deliver doesn't do this).
def update_what_to_test(bundle_id, what_to_test_path)
  Spaceship::ConnectAPI.login(APPLE_LOGIN)
  app = Spaceship::ConnectAPI::App.find(bundle_id)
  UI.user_error!("App not found: #{bundle_id}") unless app

  what_to_test = File.read(what_to_test_path)
  builds = app.get_builds(sort: "-uploadedDate", includes: "betaBuildLocalizations")
  UI.user_error!("No builds for #{bundle_id} — upload one first") unless builds.any?

  build = builds.first
  loc = (build.beta_build_localizations || []).find { |l| l.locale == "en-US" }
  if loc
    loc.update(attributes: { whatsNew: what_to_test })
    UI.success("Updated 'What to Test' on #{bundle_id} build #{build.version} (#{build.build_number})")
  else
    UI.important("No en-US localization on build #{build.version} — set it manually in App Store Connect")
  end
end

platform :mac do
  desc "Upload App Store metadata (text only — no binary, no screenshots)"
  lane :metadata do
    deliver(
      app_identifier: APP_ID, team_id: TEAM_ID, platform: "osx",
      api_key: asc_api_key,
      skip_binary_upload: true, skip_screenshots: true, force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: META_PATH
    )
  end

  desc "Upload App Store screenshots"
  lane :screenshots do
    deliver(
      app_identifier: APP_ID, team_id: TEAM_ID, platform: "osx",
      api_key: asc_api_key,
      skip_binary_upload: true, skip_metadata: true,
      overwrite_screenshots: true, force: true,
      precheck_include_in_app_purchases: false,
      screenshots_path: SHOTS_PATH
    )
  end

  desc "Upload everything — metadata + screenshots"
  lane :deliver_all do
    deliver(
      app_identifier: APP_ID, team_id: TEAM_ID, platform: "osx",
      api_key: asc_api_key,
      skip_binary_upload: true, overwrite_screenshots: true, force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: META_PATH, screenshots_path: SHOTS_PATH
    )
  end

  desc "Upload the Mac App Preview (previews_mac/en-US). dry_run:true checks the spec only"
  lane :previews do |options|
    upload_app_previews(
      platform: Spaceship::ConnectAPI::Platform::MAC_OS, preview_type: "DESKTOP",
      dir: MAC_PREVIEWS, sizes: [[1920, 1080]], dry_run: options[:dry_run]
    )
  end

  desc "Update TestFlight 'What to Test' on the latest build"
  lane :beta_metadata do
    update_what_to_test(APP_ID, "#{TESTFLIGHT_DIR}/notes/macos.en-US.txt")
  end
end

platform :ios do
  desc "Upload App Store metadata for iPhone + iPad (text only). Name/subtitle are shared with the Mac."
  lane :metadata do
    deliver(
      app_identifier: APP_ID, team_id: TEAM_ID, platform: "ios",
      api_key: asc_api_key,
      skip_binary_upload: true, skip_screenshots: true, force: true,
      precheck_include_in_app_purchases: false,
      metadata_path: IOS_META_PATH
    )
  end

  desc "Upload App Store screenshots (iPhone + iPad sizes, detected by pixel size)"
  lane :screenshots do
    deliver(
      app_identifier: APP_ID, team_id: TEAM_ID, platform: "ios",
      api_key: asc_api_key,
      skip_binary_upload: true, skip_metadata: true,
      overwrite_screenshots: true, force: true,
      precheck_include_in_app_purchases: false,
      screenshots_path: IOS_SHOTS_PATH
    )
  end

  desc "Upload the iPhone 6.9\" App Preview (previews_ios/en-US). dry_run:true checks the spec only"
  lane :previews do |options|
    upload_app_previews(
      platform: Spaceship::ConnectAPI::Platform::IOS, preview_type: "IPHONE_67",
      dir: IOS_PREVIEWS, sizes: [[886, 1920]], dry_run: options[:dry_run]
    )
  end
end
