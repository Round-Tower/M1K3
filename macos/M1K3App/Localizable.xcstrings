    "You already have everything I can fetch here. Nothing to download." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast schon alles, was ich hier laden kann. Es gibt nichts herunterzuladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes todo lo que puedo descargar aquí. No hay nada que descargar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as déjà tout ce que je peux récupérer ici. Rien à télécharger."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você já tem tudo o que eu consigo baixar aqui. Não há nada para baixar."
          }
        }
      }
    },
    "Your Mac is blocking Speech Recognition for M1K3. Flip it on in System Settings, then try me again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu Mac está bloqueando el reconocimiento de voz para M1K3. Actívalo en Ajustes del Sistema y vuelve a probar conmigo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Mac está bloqueando o Reconhecimento de Fala para o M1K3. Ligue-o nos Ajustes do Sistema e tente falar comigo de novo."
          }
        }
      }
    },
    "Your Mac is blocking the mic. Flip M1K3 on in System Settings, then try me again." : {
