    "“%@” wants to pair" : {

    },
    "“Menu bar only” hides the Dock icon and starts M1K3 quietly — open it anytime from the menu bar." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nur Menüleiste“ blendet das Dock-Symbol aus und startet M1K3 im Hintergrund – öffne es jederzeit über die Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Solo en la barra de menús” oculta el icono del Dock e inicia M1K3 discretamente: ábrelo cuando quieras desde la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Uniquement dans la barre des menus » masque l’icône du Dock et lance M1K3 discrètement — ouvre-le quand tu veux depuis la barre des menus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Só na barra de menus” oculta o ícone do Dock e inicia o M1K3 discretamente — abra-o quando quiser pela barra de menus."
          }
        }
      }
    },
    "•" : {
      "shouldTranslate" : false
    }
  },
  "version" : "1.0"
}