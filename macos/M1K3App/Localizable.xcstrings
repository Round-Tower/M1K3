        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El primer pulso llega como mucho un par de horas después de que el Mac esté activo; antes si ya ha pasado algo hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
