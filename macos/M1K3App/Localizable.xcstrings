          }
        }
      }
    },
    "Reasoning" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachdenken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Razonamiento"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raisonnement"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raciocínio"
          }
        }
      }
    },
    "Reasoning models think before answering — sharper on hard questions, slower on small talk. Auto decides per turn; voice mode has its own toggle and ignores this setting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelle, die nachdenken, überlegen vor der Antwort – treffsicherer bei schwierigen Fragen, langsamer beim Smalltalk. „Auto“ entscheidet bei jeder Nachricht neu; der Sprachmodus hat einen eigenen Schalter und ignoriert diese Einstellung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los modelos de razonamiento piensan antes de responder: más precisos en preguntas difíciles, más lentos en la charla informal. Auto decide en cada turno; el modo de voz tiene su propio interruptor e ignora este ajuste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les modèles de raisonnement réfléchissent avant de répondre — plus pointus sur les questions difficiles, plus lents pour bavarder. Auto décide à chaque échange ; le mode vocal a son propre réglage et ignore celui-ci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modelos de raciocínio pensam antes de responder — mais afiados em perguntas difíceis, mais lentos em conversas simples. O Automático decide a cada mensagem; o modo de voz tem seu próprio interruptor e ignora este ajuste."
          }
        }
      }
    },
