<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mac App Store entitlements. Identical to M1K3.entitlements MINUS the two
	     audioanalyticsd mach-lookup exceptions, which the App Store rejects
	     (temporary-exception.* and private-service exception.mach-lookup are
	     disallowed). Those exist only for the AVSpeechSynthesizer system-voice
	     path; the Kokoro neural voice (on-device MLX/Metal, no mach service —
	     ONNX Runtime removed 2026-07-18) needs none of them. See
	     macos/tools/release/README.md §2. -->

	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- Write access ONLY to folders the user picks in an open panel — used
	     solely for installing approved scripts into the Application Scripts
	     folder (the hands' one-time grant; see AppEnvironment+Scripts). -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Outbound: on-device model-weight downloads (HuggingFace) on first use. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Inbound: the loopback MCP server + the QR-paired Brain at Home LAN
	     service (both default OFF; see M1K3.entitlements for the full note). -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Microphone for on-device voice input (Apple Speech / WhisperKit). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The context senses (docs/CONTEXT_TOOLS_PLAN.md): calendar_peek and
	     current_location — both behind default-OFF Settings toggles AND the
	     system TCC prompt; snapshots only, never off-device. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Private Cloud Compute (ADR 0006): Apple assigned the managed capability
	     to team 76DJH43A4P on 2026-09-14. STORE LANE ONLY: it is a restricted
	     entitlement and needs a provisioning profile, so M1K3.entitlements (the
	     Developer ID lane, no profile) must never carry it — AMFI would refuse to
	     launch the app. Without it the PCC backend reads absent, by design. -->
	<key>com.apple.developer.private-cloud-compute</key>
	<true/>
	<!-- Declared Age Range (Content Controls, gates 13/16/18): without it the API
	     refuses before any sheet, so "Set up" did nothing (build 375, 2026-10-01).
	     An App ID capability, so store lane only, like PCC above; the guard
	     check_store_targets.py pins it here and keeps it out of M1K3.entitlements. -->
	<key>com.apple.developer.declared-age-range</key>
	<true/>
</dict>
</plist>
